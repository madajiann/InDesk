# Android 签名配置模板
# ------------------------------------------------------------
# 用法：复制本文件为 keystore.properties，填入你自己的值。
#       keystore.properties 已在 .gitignore 中，永不入库。
#       仓库里不包含任何 .jks 文件。
# ------------------------------------------------------------

# keystore 文件路径（相对 mobile-app/ 目录）
storeFile=your-release.jks

# keystore 密码
storePassword=

# 密钥别名
keyAlias=

# 密钥密码（多数情况下与 storePassword 相同）
keyPassword=
